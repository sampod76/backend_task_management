PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
PUSHER_USE_TLS=true
EMAIL_PROVIDER=aws-ses

# AWS SES SMTP
AWS_SES_USER_NAME=
AWS_SES_HOST=email-smtp.us-east-1.amazonaws.com
AWS_SES_PORT=587
AWS_SES_SECURE=false
AWS_SES_SMTP_USER_NAME=
AWS_SES_SMTP_PASSWORD=
DEFAULT_SENDER_EMAIL=

# Gmail SMTP - local/dev/testing only
NODEMAILER_AUTH_EMAIL=
NODEMAILER_AUTH_PASS=
GMAIL_SENDER_EMAIL=

# CORS Configuration
# Comma-separated list of allowed origins. Use empty string for development defaults.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,X-Request-Id
CORS_EXPOSED_HEADERS=X-Request-Id
CORS_MAX_AGE=86400
